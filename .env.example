# Dashboard security (replace every value before starting)
DASHBOARD_PASSWORD=replace-with-at-least-12-characters
# Optional second dashboard password with full access (minimum 8 characters).
GUEST_PASSWORD=
SESSION_SECRET=replace-with-at-least-32-random-characters
CONFIG_ENCRYPTION_KEY=replace-with-at-least-32-random-characters

# Persistent data. In Codespaces/local development this directory stays in the workspace.
DATA_DIR=./data

# Minecraft defaults; accounts can also be configured in the dashboard.
MC_HOST=hugosmp.net
MC_PORT=25565
MC_VERSION=1.21.4
MC_USERNAME=
AUTO_CONNECT=false

# Dashboard port. Codespaces can expose it privately from the Ports panel.
PORT=3000

# Optional Base32 secret for dashboard two-factor authentication.
DASHBOARD_TOTP_SECRET=
