API_TOKEN=replace-with-at-least-32-random-characters
PORT=8788
MINECRAFT_HOST=play.example.net
MINECRAFT_PORT=25565
MINECRAFT_VERSION=26.1
MINECRAFT_USERNAME=stable-account-cache-id
SOCKS5_HOST=proxy.example.net
SOCKS5_PORT=1080
SOCKS5_USERNAME=
SOCKS5_PASSWORD=
AUTH_CACHE_DIR=/home/node/.minecraft
# Optional: enables the RCC "Railway-IP" button. Direct mode is accepted only
# when the worker is actually deployed on Railway, never from a local machine.
ALLOW_RAILWAY_DIRECT_EGRESS=false
